# ==============================================================================
# Kaveron Agency - Environment Variables Template
# Copy this file to .env for local development. Never commit real secret keys.
# ==============================================================================

# Frontend Public Variables (Safe in client bundle)
VITE_SITE_URL=https://kaveron.com
SITE_URL=https://kaveron.com

# Supabase Public Configuration (Vite client)
# Anon key is public by design and restricted by Row-Level Security (RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# Supabase Edge Functions Secrets (DO NOT put these in frontend .env!)
# Set these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI: supabase secrets set KEY=VALUE
# ==============================================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# SITE_URL=

# Chat Edge Function - set in Supabase secrets, NOT here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
MAX_DAILY_MESSAGES=2000
